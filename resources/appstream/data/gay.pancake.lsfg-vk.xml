  <name>LSFG-VK</name>
  <summary>Vulkan frame generation for Linux games</summary>

  <description>
    <p>
      LSFG-VK is a Vulkan layer that brings frame generation to Linux games,
      interpolating frames to boost perceived framerate without requiring
      native game support. It works as a drop-in layer across any Vulkan title.
    </p>
    <ul>
      <li>Frame generation via Vulkan layer — no game modifications needed</li>
      <li>Works with Steam, Lutris, and native Vulkan titles</li>
      <li>Graphical UI for configuring the layer per-game</li>
      <li>Low-latency interpolation tuned for gaming</li>
    </ul>
  </description>

  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>frame generation</keyword>
    <keyword>vulkan</keyword>
    <keyword>gaming</keyword>
    <keyword>fps</keyword>
    <keyword>interpolation</keyword>
    <keyword>lsfg</keyword>
  </keywords>

  <pkgname>lsfg-vk</pkgname>

  <icon type="stock">gay.pancake.lsfg-vk-ui</icon>

  <url type="homepage">https://github.com/PancakeTAS/lsfg-vk</url>
